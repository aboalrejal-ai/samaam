# ── LLM provider (OpenAI-compatible) ─────────────────────────
# انسخ هذا الملف إلى .env وحط المفتاح. .env مستبعد من git.
#
# GLM / Z.ai        → https://api.z.ai/api/paas/v4        | glm-4.6
# OpenRouter        → https://openrouter.ai/api/v1        | z-ai/glm-4.6
# Alibaba DashScope → https://dashscope-intl.aliyuncs.com/compatible-mode/v1 | qwen-max

SAMAAM_LLM_BASE_URL=https://api.z.ai/api/paas/v4
SAMAAM_LLM_API_KEY=
SAMAAM_LLM_MODEL=glm-4.6

# ── Embeddings ───────────────────────────────────────────────
# محلية بالكامل عبر ChromaDB. لا تحتاج مفتاح ولا إنترنت.
SAMAAM_EMBED_MODEL=all-MiniLM-L6-v2
