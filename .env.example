# ═══════════════════════════════════════════════════════════════
#  صمّام — إعدادات البيئة
#  انسخ هذا الملف باسم .env وضع المفتاح في السطر المعلَّم أدناه.
#  ملف .env مستبعد من git ولن يُرفع أبداً.
# ═══════════════════════════════════════════════════════════════

# ── ١. نموذج الاستدلال (عقدة M في معيار Y.3172) ───────────────
# الافتراضي: Z.AI عبر واجهتها المتوافقة مع OpenAI.
# لاحظ الشرطة المائلة في نهاية الرابط — هكذا وردت في توثيقهم.

SAMAAM_LLM_BASE_URL=https://api.z.ai/api/paas/v4/

#          ↓↓↓  ضع مفتاح Z.AI هنا بعد علامة =  ↓↓↓
SAMAAM_LLM_API_KEY=
#          ↑↑↑  من https://z.ai/manage-apikey/apikey-list  ↑↑↑

# glm-4.6 إصدار مستقر ويكفي لشرح قرارات السياسات.
# للترقية: بدّلها بـ glm-5.3 — لا يتغير أي شيء آخر.
SAMAAM_LLM_MODEL=glm-4.6

# ── مزوّدون بديلون (بدّل السطرين أعلاه فقط) ────────────────────
# OpenRouter        → https://openrouter.ai/api/v1        | z-ai/glm-4.6
# Alibaba DashScope → https://dashscope-intl.aliyuncs.com/compatible-mode/v1 | qwen-max

# ── ٢. التضمين (عقدة PP) — لا يحتاج مفتاحاً ────────────────────
# Z.AI لا توفّر نماذج تضمين، لذلك يُحسب محلياً داخل ChromaDB.
# يعمل بلا إنترنت — وهذا يحمي الديمو لو سقطت الشبكة في القاعة.
SAMAAM_EMBED_MODEL=intfloat/multilingual-e5-small
